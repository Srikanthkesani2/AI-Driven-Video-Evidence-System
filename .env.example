# 1. FastAPI Application Configurations
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# 2. Azure AI Services Integration (Omit to use high-fidelity simulator)
AZURE_API_KEY=your_azure_speech_and_vision_key
AZURE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_VIDEO_INDEXER_ID=your_video_indexer_account_id

# 3. Azure OpenAI Configurations (For LangChain RAG & LLM)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
